[application]

config/name="Godoxel - Image Editor"
run/main_scene="res://addons/Godoxel/Editor.tscn"
config/icon="res://icon.png"

[autoload]

PlayerStats="*res://Player/PlayerStats.tscn"
PauseMenu="*res://OtherScreens/PauseMenu.tscn"
BackgroundMusic="*res://Music and Sounds/BackgroundMusic.tscn"
MessageBox="*res://OtherScreens/MessageBox.tscn"
SceneTransition="*res://Overlap/SceneTransition.tscn"
DataManager="*res://Overlap/DataManager.gd"

[display]

window/size/width=1280
window/size/height=720
window/size/test_width=960
window/size/test_height=540
window/stretch/mode="2d"
window/stretch/aspect="keep"

[editor_plugins]

enabled=PoolStringArray( "res://addons/Godoxel/plugin.cfg" )

[gui]

common/drop_mouse_on_gui_input_disabled=true

[importer_defaults]

texture={
"compress/bptc_ldr": 0,
"compress/hdr_mode": 0,
"compress/lossy_quality": 0.7,
"compress/mode": 0,
"compress/normal_map": 0,
"detect_3d": false,
"flags/anisotropic": false,
"flags/filter": false,
"flags/mipmaps": false,
"flags/repeat": 0,
"flags/srgb": 2,
"process/HDR_as_SRGB": false,
"process/fix_alpha_border": true,
"process/invert_color": false,
"process/normal_map_invert_y": false,
"process/premult_alpha": false,
"size_limit": 0,
"stream": false,
"svg/scale": 1.0
}

